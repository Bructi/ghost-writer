{
  "manifest_version": 3,
  "name": "Ghost-Writer HUD",
  "version": "1.0.0",
  "action": { "default_popup": "index.html" },
  "permissions": ["activeTab"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["assets/content.js"], 
      "run_at": "document_end"
    }
  ]
}